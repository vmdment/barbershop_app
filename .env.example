# ============================================================
# CONFIGURACIÓN DE LA BASE DE DATOS (ejemplo)
# ============================================================
# Pasos para cada integrante del equipo:
#   1. Copie este archivo y nombre la copia como: .env
#      (en la misma carpeta que main.py)
#   2. Cambie los valores según SU instalación de MySQL.
#   3. No suba el .env a GitHub: ya está en .gitignore.
#
# Formato: VARIABLE=valor (sin espacios alrededor del =, sin comillas).
# Las líneas que empiezan con # son comentarios.
# ============================================================

# Driver ODBC de MySQL instalado en su computador.
# Para ver el nombre exacto: Windows > "Orígenes de datos ODBC" > pestaña Controladores.
# Ejemplos: MySQL ODBC 8.0 Unicode Driver / MySQL ODBC 9.1 Unicode Driver
DB_DRIVER=MySQL ODBC 26.7 Unicode Driver

# Servidor donde corre MySQL (localhost = su propio computador).
DB_SERVER=localhost

# Puerto de MySQL (3306 es el predeterminado).
DB_PORT=3306

# Nombre de la base de datos que crea el script bd.sql.
DB_NAME=barbershop_db

# Usuario y contraseña de MySQL con los que se conecta la aplicación.
# Puede usar root o un usuario propio con permiso EXECUTE sobre barbershop_db:
#   CREATE USER 'usuario_python'@'localhost' IDENTIFIED BY 'su_contraseña';
#   GRANT EXECUTE ON barbershop_db.* TO 'usuario_python'@'localhost';
DB_USER=usuario_python
DB_PASSWORD=su_contraseña

# ============================================================
# API REST (api.py)
# ============================================================
# Orígenes (direcciones) desde los que la aplicación web (proyecto Front) puede llamar a la API,
# separados por coma. Por defecto http://localhost:5500 (py servidor.py del Front).
# Use * para permitir cualquier origen.
CORS_ORIGENES=http://localhost:5500

# Clave con la que se firman los tokens de inicio de sesión. Use un texto largo y aleatorio, por ejemplo
# el que imprime:  py -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacía, se genera una al iniciar la API y las sesiones se pierden al reiniciarla.
CLAVE_SECRETA=

# Horas que dura una sesión antes de tener que iniciar sesión de nuevo.
SESION_HORAS=8
